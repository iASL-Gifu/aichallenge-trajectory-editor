<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>editor_tool_server</name>
  <version>0.0.0</version>
  <description>Interactive marker server for editing AI Challenge trajectory CSV files in RViz.</description>
  <maintainer email="toki_haya_41@icloud.com">aress-22</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>visualization_msgs</depend>
  <depend>interactive_markers</depend>
  <depend>geometry_msgs</depend>
  <depend>editor_tool_srvs</depend>
  <depend>tf2</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>std_srvs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
